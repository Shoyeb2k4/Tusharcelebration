// Tushar Celebrations ERP — Prisma schema
// PostgreSQL (Supabase). Multi-tenant: every business row carries orgId.
// Tenant isolation enforced by Postgres RLS + Prisma middleware + API guard.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Tenancy, identity & access control
// ============================================================

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  currency     String   @default("INR")
  timezone     String   @default("Asia/Kolkata")
  gstNumber    String?
  address      String?
  settings     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  venues       Venue[]
  customers    Customer[]
  enquiries    Enquiry[]
  quotations   Quotation[]
  bookings     Booking[]
  events       Event[]
  vendors      Vendor[]
  inventory    InventoryItem[]
  staff        Staff[]
  packages     Package[]
  tasks        Task[]
  auditLogs    AuditLog[]
  notifications Notification[]
  messageLogs  MessageLog[]

  @@index([slug])
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  authUserId   String   @unique // Supabase auth.users.id
  email        String
  fullName     String
  phone        String?
  avatarUrl    String?
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedEnquiries Enquiry[]        @relation("EnquiryOwner")
  createdTasks      Task[]           @relation("TaskCreator")
  assignedTasks     Task[]           @relation("TaskAssignee")
  approvals         Approval[]       @relation("ApprovalActor")
  dashboardLayout   DashboardLayout?

  @@unique([orgId, email])
  @@index([orgId])
}

model Role {
  id          String   @id @default(cuid())
  orgId       String?  // null = system template role
  key         String   // SUPER_ADMIN, OWNER, GM, SALES, EVENT_MANAGER, ACCOUNTS, ...
  name        String
  description String?
  // Permission map: { "<resource>": ["create","read","update","delete","approve","export"] }
  permissions Json     @default("{}")
  isSystem    Boolean  @default(false)
  users       User[]

  @@unique([orgId, key])
}

model DashboardLayout {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgets  Json   @default("[]") // ordered [{id,type,x,y,w,h,config}]
  updatedAt DateTime @updatedAt
}

// ============================================================
// CRM
// ============================================================

model Customer {
  id         String   @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  company    String?
  email      String?
  phone      String
  address    String?
  portalToken String? @unique // scoped customer portal access
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contacts   Contact[]
  enquiries  Enquiry[]
  bookings   Booking[]

  @@index([orgId])
  @@index([orgId, phone])
}

model Contact {
  id         String  @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  relation   String? // spouse, planner, father, ...
  phone      String?
  email      String?
  isPrimary  Boolean @default(false)
}

enum EnquiryStage {
  NEW
  FOLLOW_UP
  SITE_VISIT
  QUOTATION_SENT
  NEGOTIATION
  CONFIRMED
  LOST
}

enum EnquirySource {
  WALK_IN
  PHONE
  WHATSAPP
  REFERRAL
  WEBSITE
  SOCIAL
  BROKER
  OTHER
}

model Enquiry {
  id            String   @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  code          String   // ENQ-2026-000123
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  eventType     String
  eventDate     DateTime?
  alternateDates DateTime[]
  expectedGuests Int?
  budget        Decimal? @db.Decimal(12, 2)
  requirements  String?
  source        EnquirySource @default(OTHER)
  stage         EnquiryStage  @default(NEW)
  lostReason    String?
  ownerId       String?
  owner         User?    @relation("EnquiryOwner", fields: [ownerId], references: [id])
  firstResponseAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  followUps     FollowUp[]
  pipelineEvents PipelineEvent[]
  attachments   Attachment[]
  quotations    Quotation[]
  booking       Booking?

  @@unique([orgId, code])
  @@index([orgId, stage])
  @@index([orgId, ownerId])
}

model FollowUp {
  id         String   @id @default(cuid())
  enquiryId  String
  enquiry    Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  dueAt      DateTime
  channel    String   // call, whatsapp, email, visit
  note       String?
  completedAt DateTime?
  outcome    String?
  createdAt  DateTime @default(now())

  @@index([enquiryId])
  @@index([dueAt])
}

model PipelineEvent {
  id        String   @id @default(cuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  fromStage EnquiryStage?
  toStage   EnquiryStage
  actorId   String?
  note      String?
  createdAt DateTime @default(now())
}

// ============================================================
// Venues & availability
// ============================================================

model Venue {
  id         String   @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  type       String   // hall, lawn, conference, dining, outdoor
  capacity   Int
  basePrice  Decimal  @db.Decimal(12, 2)
  facilities String[]
  photos     String[]
  layouts    Json     @default("[]")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  timeSlots  TimeSlot[]
  bookings   Booking[]

  @@index([orgId])
}

model TimeSlot {
  id       String @id @default(cuid())
  venueId  String
  venue    Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  label    String // Morning, Evening, Full Day
  startTime String // "09:00"
  endTime   String // "16:00"
}

// ============================================================
// Quotations
// ============================================================

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  code        String   // QUO-2026-000045
  enquiryId   String?
  enquiry     Enquiry? @relation(fields: [enquiryId], references: [id])
  version     Int      @default(1)
  status      QuotationStatus @default(DRAFT)
  validUntil  DateTime?
  subtotal    Decimal  @db.Decimal(12, 2) @default(0)
  discount    Decimal  @db.Decimal(12, 2) @default(0)
  taxRate     Decimal  @db.Decimal(5, 2)  @default(0)
  taxAmount   Decimal  @db.Decimal(12, 2) @default(0)
  total       Decimal  @db.Decimal(12, 2) @default(0)
  notes       String?
  pdfUrl      String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lineItems   QuotationLineItem[]
  booking     Booking?

  @@unique([orgId, code, version])
  @@index([orgId, status])
}

model QuotationLineItem {
  id          String  @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  category    String  // venue, catering, decoration, rooms, addon
  quantity    Decimal @db.Decimal(10, 2) @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  isOptional  Boolean @default(false)
  packageId   String?
}

// ============================================================
// Bookings & Events
// ============================================================

enum BookingStatus {
  TENTATIVE
  CONFIRMED
  CANCELLED
  RESCHEDULED
  COMPLETED
}

model Booking {
  id           String   @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  code         String   // BKG-2026-000012
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  enquiryId    String?  @unique
  enquiry      Enquiry? @relation(fields: [enquiryId], references: [id])
  quotationId  String?  @unique
  quotation    Quotation? @relation(fields: [quotationId], references: [id])
  venueId      String
  venue        Venue    @relation(fields: [venueId], references: [id])
  status       BookingStatus @default(TENTATIVE)
  eventDate    DateTime
  startAt      DateTime
  endAt        DateTime
  guestCount   Int
  totalAmount  Decimal  @db.Decimal(12, 2) @default(0)
  advanceAmount Decimal @db.Decimal(12, 2) @default(0)
  agreementUrl String?
  terms        String?
  cancelReason String?
  rescheduledFrom DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event        Event?

  // Double-booking guard: a Postgres exclusion constraint on
  // (venueId, tstzrange(startAt,endAt)) WHERE status IN (TENTATIVE,CONFIRMED)
  // is added via raw migration (see DATABASE_SCHEMA.md).
  @@unique([orgId, code])
  @@index([orgId, status])
  @@index([venueId, startAt, endAt])
}

model Event {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  title       String
  status      String   @default("planning") // planning, in_progress, completed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments      Payment[]
  invoices      Invoice[]
  expenses      Expense[]
  roomAllocations RoomAllocation[]
  decoration    DecorationAssignment?
  cateringOrder CateringOrder?
  inventoryReservations InventoryReservation[]
  tasks         Task[]
  milestones    TimelineMilestone[]
  staffAssignments StaffAssignment[]
  vendorEngagements VendorEngagement[]
  documents     Document[]
  photos        Attachment[]
  notes         EventNote[]
  approvals     Approval[]

  @@index([orgId, status])
}

model EventNote {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorId  String?
  body      String
  isInternal Boolean @default(true)
  createdAt DateTime @default(now())
}

// ============================================================
// Finance
// ============================================================

enum PaymentType { ADVANCE INSTALLMENT FINAL REFUND }
enum PaymentMethod { CASH BANK_TRANSFER UPI CARD CHEQUE ONLINE }

model Payment {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      PaymentType
  method    PaymentMethod
  amount    Decimal  @db.Decimal(12, 2)
  reference String?
  receivedAt DateTime @default(now())
  receiptUrl String?
  recordedById String?
  createdAt DateTime @default(now())

  @@index([eventId])
}

model Invoice {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code      String   // INV-2026-000034
  amount    Decimal  @db.Decimal(12, 2)
  taxAmount Decimal  @db.Decimal(12, 2) @default(0)
  total     Decimal  @db.Decimal(12, 2)
  status    String   @default("issued") // issued, paid, partial, void
  issuedAt  DateTime @default(now())
  dueAt     DateTime?
  pdfUrl    String?

  @@unique([eventId, code])
}

model Expense {
  id        String   @id @default(cuid())
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id])
  category  String   // decoration, food, photography, generator, electricity, flowers, cleaning, misc
  description String
  amount    Decimal  @db.Decimal(12, 2)
  vendorId  String?
  incurredAt DateTime @default(now())
  approvedById String?
  receiptUrl String?

  @@index([eventId])
  @@index([category])
}

// ============================================================
// Catering (Bonbon operations)
// ============================================================

model CateringOrder {
  id          String  @id @default(cuid())
  eventId     String  @unique
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestCount  Int
  perPlate    Decimal @db.Decimal(10, 2) @default(0)
  packageId   String?
  status      String  @default("draft") // draft, locked, in_prep, served
  lockedAt    DateTime?
  menuItems   CateringMenuItem[]
  productionSheet ProductionSheet?
  createdAt   DateTime @default(now())
}

model CateringMenuItem {
  id        String  @id @default(cuid())
  orderId   String
  order     CateringOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name      String
  course    String  // starter, main, dessert, live_counter, sweet_counter, beverage
  quantity  Decimal @db.Decimal(10, 2) @default(1)
  unit      String  @default("plate")
}

model ProductionSheet {
  id        String  @id @default(cuid())
  orderId   String  @unique
  order     CateringOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  prepSchedule Json  @default("[]") // [{time, task, station}]
  foodCost  Decimal @db.Decimal(12, 2) @default(0)
  pdfUrl    String?
  generatedAt DateTime @default(now())
  ingredients IngredientRequirement[]
}

model IngredientRequirement {
  id        String  @id @default(cuid())
  sheetId   String
  sheet     ProductionSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  name      String
  quantity  Decimal @db.Decimal(12, 3)
  unit      String
  inventoryItemId String?
}

// ============================================================
// Decoration
// ============================================================

model DecorationAssignment {
  id         String  @id @default(cuid())
  eventId    String  @unique
  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  packageId  String?
  tier       String? // basic, traditional, premium, luxury, royal
  estimatedCost Decimal @db.Decimal(12, 2) @default(0)
  labourCost Decimal @db.Decimal(12, 2) @default(0)
  setupMinutes Int    @default(0)
  status     String  @default("planned") // planned, approved, setup, done
  approvedByCustomer Boolean @default(false)
  materials  DecorationMaterial[]
}

model DecorationMaterial {
  id        String  @id @default(cuid())
  assignmentId String
  assignment DecorationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  name      String
  quantity  Decimal @db.Decimal(10, 2)
  unit      String  @default("pc")
  inventoryItemId String?
}

// ============================================================
// Packages (menu & decoration templates)
// ============================================================

model Package {
  id        String  @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type      String  // menu, decoration
  name      String
  tier      String?
  price     Decimal @db.Decimal(12, 2) @default(0)
  images    String[]
  spec      Json    @default("{}") // items/materials/labour/setup
  isActive  Boolean @default(true)

  @@index([orgId, type])
}

// ============================================================
// Guest rooms
// ============================================================

model RoomAllocation {
  id        String  @id @default(cuid())
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roomNumber String
  side      String  // bride, groom, vip, common
  category  String  // complimentary, paid
  price     Decimal @db.Decimal(10, 2) @default(0)
  guestName String?
  checkInAt DateTime?
  checkOutAt DateTime?
  housekeeping String @default("pending") // pending, cleaning, ready
  status    String  @default("reserved")  // reserved, occupied, vacated

  @@index([eventId])
}

// ============================================================
// Vendors
// ============================================================

model Vendor {
  id        String  @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  category  String  // decorator, photographer, band, dj, florist, transport, generator, security
  phone     String?
  email     String?
  rating    Decimal? @db.Decimal(2, 1)
  rateCard  Json    @default("{}")
  documents String[]
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())

  engagements VendorEngagement[]
  contracts   VendorContract[]

  @@index([orgId, category])
}

model VendorContract {
  id        String  @id @default(cuid())
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  title     String
  fileUrl   String?
  startsAt  DateTime?
  endsAt    DateTime?
  terms     String?
}

model VendorEngagement {
  id        String  @id @default(cuid())
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id])
  service   String
  agreedRate Decimal @db.Decimal(12, 2) @default(0)
  status    String  @default("engaged") // engaged, confirmed, completed, cancelled
  purchaseOrders PurchaseOrder[]

  @@index([eventId])
}

model PurchaseOrder {
  id        String  @id @default(cuid())
  engagementId String
  engagement VendorEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  code      String
  amount    Decimal @db.Decimal(12, 2)
  status    String  @default("issued") // issued, paid
  pdfUrl    String?
  createdAt DateTime @default(now())
}

// ============================================================
// Inventory
// ============================================================

enum InventoryStatus { AVAILABLE RESERVED IN_USE DAMAGED MAINTENANCE LOST }

model InventoryItem {
  id        String  @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sku       String?
  name      String
  category  String  // furniture, stage, decor, lighting, sound, crockery, kitchen, flowers, generator, cleaning
  unit      String  @default("pc")
  quantity  Int     @default(0)
  reorderLevel Int  @default(0)
  status    InventoryStatus @default(AVAILABLE)
  location  String?
  createdAt DateTime @default(now())

  reservations InventoryReservation[]
  movements    StockMovement[]

  @@index([orgId, category])
}

model InventoryReservation {
  id        String  @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  quantity  Int
  fromAt    DateTime
  toAt      DateTime
  status    String  @default("reserved") // reserved, issued, returned

  @@index([itemId])
  @@index([eventId])
}

model StockMovement {
  id        String  @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      String  // in, out, adjust, damage, loss
  quantity  Int
  reason    String?
  actorId   String?
  createdAt DateTime @default(now())
}

// ============================================================
// Staff
// ============================================================

model Staff {
  id        String  @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  department String // kitchen, decoration, accounts, housekeeping, security, maintenance, sales, management
  phone     String?
  salary    Decimal? @db.Decimal(12, 2)
  joinedAt  DateTime?
  documents String[]
  isActive  Boolean @default(true)

  attendance Attendance[]
  shifts     Shift[]
  leaves     Leave[]
  assignments StaffAssignment[]

  @@index([orgId, department])
}

model Attendance {
  id        String  @id @default(cuid())
  staffId   String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  status    String  @default("present") // present, absent, half_day, leave

  @@unique([staffId, date])
}

model Shift {
  id        String  @id @default(cuid())
  staffId   String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  startTime String
  endTime   String
  role      String?
}

model Leave {
  id        String  @id @default(cuid())
  staffId   String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  fromDate  DateTime @db.Date
  toDate    DateTime @db.Date
  type      String   // casual, sick, unpaid
  status    String   @default("pending") // pending, approved, rejected
  reason    String?
}

model StaffAssignment {
  id        String  @id @default(cuid())
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staff   @relation(fields: [staffId], references: [id])
  role      String
  status    String  @default("assigned")

  @@index([eventId])
}

// ============================================================
// Tasks, timeline, checklists, approvals
// ============================================================

enum TaskPriority { LOW MEDIUM HIGH URGENT }
enum TaskStatus { TODO IN_PROGRESS BLOCKED DONE }

model Task {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   TimelineMilestone? @relation(fields: [milestoneId], references: [id])
  title       String
  description String?
  department  String   // routing target
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueAt       DateTime?
  creatorId   String?
  creator     User?    @relation("TaskCreator", fields: [creatorId], references: [id])
  assigneeId  String?
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checklist   ChecklistItem[]
  comments    TaskComment[]
  attachments Attachment[]

  @@index([orgId, department, status])
  @@index([eventId])
  @@index([assigneeId])
}

model ChecklistItem {
  id        String  @id @default(cuid())
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label     String
  isDone    Boolean @default(false)
  order     Int     @default(0)
}

model TaskComment {
  id        String  @id @default(cuid())
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  body      String
  createdAt DateTime @default(now())
}

model TimelineMilestone {
  id        String  @id @default(cuid())
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label     String  // "90 days before", "Event Day", "Post Event"
  offsetDays Int    // negative = before event, 0 = event day, positive = after
  dueAt     DateTime
  status    String  @default("pending") // pending, active, done
  tasks     Task[]

  @@index([eventId])
}

enum ApprovalStatus { PENDING APPROVED REJECTED }

model Approval {
  id        String  @id @default(cuid())
  eventId   String?
  event     Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      String  // discount, expense, booking, refund
  refId     String? // id of the record awaiting approval
  amount    Decimal? @db.Decimal(12, 2)
  status    ApprovalStatus @default(PENDING)
  requestedById String?
  actorId   String?
  actor     User?   @relation("ApprovalActor", fields: [actorId], references: [id])
  note      String?
  createdAt DateTime @default(now())
  decidedAt DateTime?

  @@index([eventId])
  @@index([status])
}

// ============================================================
// Documents, attachments, audit, notifications, messaging
// ============================================================

model Document {
  id        String  @id @default(cuid())
  eventId   String?
  event     Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      String  // quotation, agreement, invoice, receipt, production_sheet, po, task_sheet, guest_list, room_allocation, decoration_checklist, completion_report
  title     String
  fileUrl   String
  createdAt DateTime @default(now())

  @@index([eventId, type])
}

model Attachment {
  id        String  @id @default(cuid())
  enquiryId String?
  enquiry   Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind      String  @default("file") // file, photo
  fileUrl   String
  caption   String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String  @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorId   String?
  action    String  // create, update, delete, approve, login, export
  resource  String  // model name
  resourceId String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([orgId, resource, resourceId])
  @@index([orgId, createdAt])
}

model Notification {
  id        String  @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String?
  type      String  // task.assigned, payment.due, risk.detected, ...
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([orgId, userId, readAt])
}

model MessageLog {
  id        String  @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel   String  // whatsapp, email
  template  String  // quotation, booking_confirmation, payment_reminder, ...
  toAddress String
  refType   String? // event, enquiry, invoice
  refId     String?
  status    String  @default("queued") // queued, sent, delivered, read, failed
  providerId String?
  payload   Json?
  createdAt DateTime @default(now())
  sentAt    DateTime?

  @@index([orgId, status])
}
