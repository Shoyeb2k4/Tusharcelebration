# Postgres (Supabase) — pooled connection string for the app runtime
DATABASE_URL="postgresql://postgres:password@localhost:5432/tushar_erp?schema=public"
# Direct connection for migrations (Supabase provides a separate non-pooled URL)
DIRECT_URL="postgresql://postgres:password@localhost:5432/tushar_erp?schema=public"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
